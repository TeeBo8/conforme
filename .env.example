# Base
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon PostgreSQL) — required
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth (Better Auth) — required
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Anthropic (Claude) — optional: without it, the explanatory paragraph is skipped
ANTHROPIC_API_KEY=sk-ant-...

# Stripe / Resend — optional, only used by the disabled paid flow (PAYMENTS_ENABLED = false)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
